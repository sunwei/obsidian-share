{
	"name": "obsidian-share",
	"version": "26.11.3",
	"description": "MDFriday Share — publish a single note as a public link. Desktop.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"svelte-check": "svelte-check --tsconfig ./tsconfig.json",
		"tsc-check": "tsc --noEmit -skipLibCheck",
		"check": "npm run tsc-check && npm run svelte-check",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"lint:ci": "eslint src/ --max-warnings=0",
		"verify:theme-config": "node scripts/verify-theme-config.mjs",
		"test": "node --test tests/*.test.ts",
		"build:with-core": "npm run build --prefix ../core && npm install --no-save ../core && npm run build",
		"build:staging": "MDF_CF_ENV=staging node esbuild.config.mjs production",
		"sync:smoke-vault": "node scripts/sync-smoke-vault.mjs",
		"build:smoke": "npm run build:staging && npm run sync:smoke-vault",
		"open:smoke-vault": "node scripts/open-smoke-vault.mjs",
		"test:e2e": "node --test --test-timeout=300000 tests/e2e/*.test.ts",
		"test:e2e:staging": "npm run build:smoke && MDF_E2E_ENV=staging npm run test:e2e",
		"test:e2e:ui:password": "node --test --test-timeout=480000 --experimental-strip-types tests/e2e/ui/01-ui-password-journey.test.ts",
		"test:e2e:password": "npm run build:smoke && MDF_E2E_ENV=staging npm run test:e2e && MDF_E2E_ENV=staging npm run test:e2e:ui:password"
	},
	"keywords": [
		"mdfriday",
		"share",
		"markdown",
		"website",
		"cloudflare"
	],
	"author": "sunwei",
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tsconfig/svelte": "^5.0.5",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.13.8",
		"esbuild": "0.25.0",
		"esbuild-svelte": "^0.9.3",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"events": "^3.3.0",
		"globals": "^17.7.0",
		"obsidian": "^1.8.7",
		"playwright": "^1.65.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.3.3",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.63.0"
	},
	"dependencies": {
		"@mdfriday/core": "26.11.0",
		"jszip": "^3.10.1"
	}
}
